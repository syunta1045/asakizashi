{
  "expo": {
    "name": "朝しるべ",
    "slug": "asakizashi",
    "version": "1.0.3",
    "scheme": "asakizashi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F2E4A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "jp.asakizashi.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "jp.asashirube.app",
      "versionCode": 9,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1422"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "@sentry/react-native",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#A82828",
          "defaultChannel": "morning"
        }
      ],
      "./plugins/withAdiRegistration"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c15f87d-287c-4c44-a18a-3eea1cfc8049"
      }
    },
    "owner": "syut"
  }
}
