# 旭兆 環境変数テンプレ
#
# .env にコピーして実際の値を設定してください
# .env はバージョン管理に含めない（.gitignore に追加済み）
#
# 変数は **アプリ側 (EXPO_PUBLIC_*)** と **Edge Function 側 (Deno secrets)** で
# 設定先が異なります。Edge Function 側は `supabase secrets set KEY=VALUE` で投入。

# ============================================================
# 【1】アプリ側 (Expo) — `.env` に置く
# EXPO_PUBLIC_* プレフィックス必須（クライアントバンドルに埋め込まれる）
# ============================================================

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- RevenueCat ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...

# --- Google Sign-in ---
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_IOS=xxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_ANDROID=xxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_WEB=xxx.apps.googleusercontent.com

# --- Sentry（任意） ---
EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# --- PostHog（任意） ---
EXPO_PUBLIC_POSTHOG_KEY=phc_...
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================================
# 【2】Edge Function 側 (Deno) — `supabase secrets set KEY=VALUE`
# 機密キー。クライアントには絶対に渡さない。
# ============================================================

# --- daily-message-batch / delete-account 共通 ---
# SUPABASE_SERVICE_ROLE_KEY=eyJ...     # Supabase ダッシュボード Settings → API
# SUPABASE_URL=https://your-project.supabase.co

# --- revenuecat-webhook ---
# REVENUECAT_WEBHOOK_SECRET=...        # RevenueCat ダッシュボード Webhooks タブ
# REVENUECAT_AUTH_HEADER=Bearer ...    # 共有 bearer（HMAC 実装までの暫定）

# --- Gemini（バッチ生成用） ---
# GEMINI_API_KEY=AIza...
